# KLEF Academic Registration Portal — Environment Configuration Example

# Server listening port (default: 3000)
PORT=3000

# Next.js Public URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Administrator Authentication (Required for Admin Portal Access)
ADMIN_ID=8897337687
ADMIN_PASSWORD=your_secure_admin_password_here

# Supabase PostgreSQL Pooler (Optional: used to retrieve student confidential data)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
